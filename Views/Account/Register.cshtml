
@model IceCreamOrderingSystem.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register | Frosty Delight</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 25px 15px;
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg,#fff2f5,#fff0df);
        }

        .register-card {
            width: 100%;
            max-width: 490px;
            padding: 35px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 18px 55px #9b52601c;
        }

        .brand { color: #b33468; font-size: 25px; font-weight: 800; }
        .muted { color: #81717a; }
        .form-control { padding: 11px; border-radius: 10px; }
        .btn-main {
            background: #b33468;
            color: white;
            border: 0;
            border-radius: 11px;
            padding: 12px;
            font-weight: 700;
        }
        .btn-main:hover { background: #92264f; color: white; }
        a { color: #a42d5d; }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="text-center mb-4">
            <div style="font-size:45px">🍨</div>
            <div class="brand">Frosty Delight</div>
            <h2 class="fw-bold mt-2">Create Account</h2>
            <p class="muted">Join us for a sweeter experience.</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number (optional)" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="At least 6 characters" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-main w-100">Create Customer Account</button>
        </form>

        <p class="text-center mt-4 mb-2">
            Already registered?
            <a asp-controller="Account" asp-action="Login">Login</a>
        </p>

        <p class="text-center mb-0">
            <a asp-controller="Home" asp-action="Index">← Back to Welcome Page</a>
        </p>
    </div>
</body>
</html>
