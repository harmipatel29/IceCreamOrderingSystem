
@model IceCreamOrderingSystem.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login | Frosty Delight</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 20px;
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #fff2f5, #fff0df);
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            padding: 38px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 18px 55px #9b52601c;
        }

        .brand {
            color: #b33468;
            font-size: 25px;
            font-weight: 800;
        }

        .muted {
            color: #81717a;
        }

        .form-control {
            padding: 12px;
            border-radius: 11px;
        }

        .form-control:focus {
            border-color: #b33468;
            box-shadow: 0 0 0 0.2rem #b3346820;
        }

        .btn-main {
            background: #b33468;
            color: white;
            border: 0;
            border-radius: 11px;
            padding: 12px;
            font-weight: 700;
            transition: 0.2s;
        }

        .btn-main:hover {
            background: #92264f;
            color: white;
            transform: translateY(-1px);
        }

        a {
            color: #a42d5d;
            text-decoration: none;
            font-weight: 600;
        }

        a:hover {
            color: #79203f;
            text-decoration: underline;
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper .form-control {
            padding-right: 75px;
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #a42d5d;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        @@media (max-width: 480px) {
            .login-card {
                padding: 27px 22px;
            }
        }
    </style>
</head>

<body>
    <div class="login-card">

        <div class="text-center mb-4">
            <div style="font-size:48px;">🍦</div>
            <div class="brand">Frosty Delight</div>
            <h2 class="fw-bold mt-3">Welcome Back!</h2>
            <p class="muted">Login to continue to your account.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="username"
                       required />

                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Password" class="form-label">
                    Password
                </label>

                <div class="password-wrapper">
                    <input asp-for="Password"
                           id="loginPassword"
                           class="form-control"
                           placeholder="Enter your password"
                           autocomplete="current-password"
                           required />

                    <button type="button"
                            class="toggle-password"
                            onclick="togglePassword()"
                            id="togglePasswordButton">
                        Show
                    </button>
                </div>

                <span asp-validation-for="Password"
                      class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between
                        align-items-center mb-4 mt-3">

                <div class="form-check">
                    <input asp-for="RememberMe"
                           class="form-check-input" />

                    <label asp-for="RememberMe"
                           class="form-check-label small">
                        Remember me
                    </label>
                </div>

                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   class="small">
                    Forgot Password?
                </a>
            </div>

            <button type="submit" class="btn btn-main w-100">
                Login to Account
            </button>
        </form>

        <div class="text-center mt-4 mb-2">
            <span class="muted">New customer?</span>
            <a asp-controller="Account"
               asp-action="Register">
                Create account
            </a>
        </div>

        <p class="text-center mb-0 mt-3">
            <a asp-controller="Home" asp-action="Index">
                ← Back to Welcome Page
            </a>
        </p>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("loginPassword");
            const toggleButton = document.getElementById("togglePasswordButton");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                toggleButton.textContent = "Hide";
            } else {
                passwordInput.type = "password";
                toggleButton.textContent = "Show";
            }
        }
    </script>
</body>
</html>
