@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password | Frosty Delight</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 20px;
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #fff2f5, #fff0df);
        }

        .reset-card {
            width: 100%;
            max-width: 440px;
            padding: 38px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 18px 55px #9b52601c;
        }

        .brand {
            color: #b33468;
            font-size: 25px;
            font-weight: 800;
        }

        .form-control {
            padding: 12px;
            border-radius: 11px;
        }

        .btn-main {
            background: #b33468;
            color: white;
            border: 0;
            border-radius: 11px;
            padding: 12px;
            font-weight: 700;
        }

        .btn-main:hover {
            background: #92264f;
            color: white;
        }

        a { color: #a42d5d; text-decoration: none; }
    </style>
</head>

<body>
    <div class="reset-card">
        <div class="text-center mb-4">
            <div style="font-size:48px;">🍦</div>
            <div class="brand">Frosty Delight</div>
            <h2 class="fw-bold mt-3">Reset Password</h2>
            <p class="text-secondary">Create your new password.</p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger">@ViewBag.Message</div>
        }

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password"
                       name="newPassword"
                       class="form-control"
                       minlength="6"
                       autocomplete="new-password"
                       required />
            </div>

            <div class="mb-4">
                <label class="form-label">Confirm New Password</label>
                <input type="password"
                       name="confirmPassword"
                       class="form-control"
                       minlength="6"
                       autocomplete="new-password"
                       required />
            </div>

            <button type="submit" class="btn btn-main w-100">
                Update Password
            </button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-controller="Account" asp-action="Login">
                ← Back to Login
            </a>
        </p>
    </div>
</body>
</html>