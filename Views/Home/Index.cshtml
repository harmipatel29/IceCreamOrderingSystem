
@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Frosty Delight | Welcome</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #fff5f5, #fff0df, #fce4ec);
            color: #30202a;
        }

        .navbar { padding: 22px 7%; }

        .brand {
            font-size: 27px;
            font-weight: 800;
            color: #a83263;
            text-decoration: none;
        }

        .hero {
            min-height: 78vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px 20px 65px;
        }

        .welcome-card {
            width: 100%;
            max-width: 1000px;
            padding: 55px 35px;
            background: rgba(255,255,255,.9);
            border: 1px solid white;
            border-radius: 28px;
            box-shadow: 0 20px 60px rgba(120,48,75,.12);
            text-align: center;
        }

        .ice-icon { font-size: 65px; margin-bottom: 15px; }

        .eyebrow {
            color: #b33b69;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-size: 12px;
        }

        h1 {
            margin: 15px 0;
            font-size: clamp(36px,6vw,58px);
            font-weight: 800;
        }

        h1 span { color: #c13d70; }

        .subtitle {
            max-width: 570px;
            margin: 0 auto 35px;
            color: #786773;
            line-height: 1.8;
        }

        .options {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .option {
            width: 220px;
            padding: 22px 18px;
            background: #fff8fa;
            border: 1px solid #f0d5df;
            border-radius: 18px;
            text-decoration: none;
            color: #392531;
            transition: .2s ease;
        }

        .option:hover {
            transform: translateY(-5px);
            border-color: #c13d70;
            box-shadow: 0 12px 25px rgba(193,61,112,.12);
        }

        .symbol { font-size: 30px; margin-bottom: 10px; }
        .option h5 { font-weight: 750; margin-bottom: 8px; }
        .option p { margin: 0; font-size: 13px; color: #806c78; }

        footer {
            text-align: center;
            padding: 18px;
            color: #8b7480;
            font-size: 13px;
        }

        @@media (max-width: 576px) {
            .welcome-card { padding: 38px 20px; }
            .option { width: 100%; max-width: 300px; }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a class="brand" href="/">🍦 Frosty Delight</a>
    </nav>

    <main class="hero">
        <section class="welcome-card">
            <div class="ice-icon">🍨</div>
            <div class="eyebrow">Happiness in every scoop</div>

            <h1>Welcome to <span>Frosty Delight</span></h1>

            <p class="subtitle">
                Discover your favourite flavours, explore delicious ice creams
                and enjoy a sweet experience with every order.
            </p>

            <div class="options">
                <a class="option" href="/Account/Login">
                    <div class="symbol">👤</div>
                    <h5>Customer Login</h5>
                    <p>Login and order your favourite ice cream.</p>
                </a>

                <a class="option" href="/Account/Register">
                    <div class="symbol">✨</div>
                    <h5>Create Account</h5>
                    <p>Register as a customer to get started.</p>
                </a>

                <a class="option" href="/Account/Login">
                    <div class="symbol">🛡️</div>
                    <h5>Admin Login</h5>
                    <p>Sign in to access the administration area.</p>
                </a>
            </div>
        </section>
    </main>

    <footer>
        © @DateTime.Now.Year Frosty Delight · Made with love and ice cream
    </footer>
</body>
</html>
