 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Frosty Delight</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IceCreamOrderingSystem.styles.css" asp-append-version="true" />

    <style>
        .frosty-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e4ece5;
            box-shadow: 0 3px 15px #173e2808;
        }

        .frosty-brand {
            color: #205b3e !important;
            font-weight: 850;
            font-size: 23px;
            letter-spacing: -.5px;
        }

        .frosty-brand span {
            color: #e49b46;
        }

        .frosty-navbar .nav-link {
            color: #45564a !important;
            font-weight: 600;
            padding: 10px 14px !important;
            border-radius: 8px;
            transition: background .2s ease, color .2s ease;
        }

        .frosty-navbar .nav-link:hover {
            background: #edf5ee;
            color: #205b3e !important;
        }

        .frosty-navbar .cart-link {
            background: #236746;
            color: #ffffff !important;
            margin-left: 5px;
        }

        .frosty-navbar .cart-link:hover {
            background: #174b31;
            color: #ffffff !important;
        }

        .frosty-footer {
            background: #f8faf8;
            padding: 20px 0;
            margin-top: 35px;
            border-top: 1px solid #e4ece5;
        }

        .frosty-footer a {
            color: #236746;
            text-decoration: none;
        }

        .frosty-footer a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 575px) {
            .frosty-brand {
                font-size: 20px;
            }

            .frosty-navbar .cart-link {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light frosty-navbar">
            <div class="container">
                <a class="navbar-brand frosty-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Frosty <span>Delight</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#frostyNavbar"
                        aria-controls="frostyNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="frostyNavbar">
                    <ul class="navbar-nav ms-auto align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
<li class="nav-item">
    <a class="nav-link"
       asp-controller="Account"
       asp-action="Login">
        Login
    </a>
</li>

<li class="nav-item">
    <a class="nav-link"
       asp-controller="Account"
       asp-action="Register">
        Register
    </a>
</li>
<form asp-controller="Account"
      asp-action="Logout"
      method="post"
      class="d-inline">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-danger">
        Logout
    </button>
</form>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Shop">
                                Shop
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link cart-link"
                               asp-controller="Cart"
                               asp-action="Index">
                                My Cart
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="frosty-footer text-muted">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <span>
                &copy; 2026 Frosty Delight. All rights reserved.
            </span>

            <a asp-controller="Home" asp-action="Privacy">
                Privacy Policy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>