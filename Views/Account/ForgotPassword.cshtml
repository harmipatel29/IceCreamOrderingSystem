
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password | Frosty Delight</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 20px;
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #fff2f5, #fff0df);
        }

        .reset-card {
            width: 100%;
            max-width: 440px;
            padding: 38px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 18px 55px #9b52601c;
        }

        .brand {
            color: #b33468;
            font-size: 25px;
            font-weight: 800;
        }

        .muted { color: #81717a; }

        .form-control {
            padding: 12px;
            border-radius: 11px;
        }

        .btn-main {
            background: #b33468;
            color: white;
            border: 0;
            border-radius: 11px;
            padding: 12px;
            font-weight: 700;
        }

        .btn-main:hover {
            background: #92264f;
            color: white;
        }

        a {
            color: #a42d5d;
            text-decoration: none;
        }

        a:hover { text-decoration: underline; }
    </style>
</head>

<body>
    <div class="reset-card">

        <div class="text-center mb-4">
            <div style="font-size:48px;">🍦</div>
            <div class="brand">Frosty Delight</div>
            <h2 class="fw-bold mt-3">Forgot Password?</h2>
            <p class="muted">
                Enter your registered email address to continue.
            </p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label for="email" class="form-label">
                    Email Address
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="email"
                       required />
            </div>

            <button type="submit" class="btn btn-main w-100">
                Continue
            </button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-controller="Account" asp-action="Login">
                ← Back to Login
            </a>
        </p>
    </div>
</body>
</html>
