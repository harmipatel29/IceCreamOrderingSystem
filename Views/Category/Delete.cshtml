
@model IceCreamOrderingSystem.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-5" style="max-width:650px">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <h2 class="fw-bold text-danger">Delete Category</h2>
        <p class="text-muted mt-2">Are you sure you want to delete this category?</p>

        <div class="rounded-3 p-3 my-3" style="background:#f5f8f5">
            <h5 class="fw-bold mb-1">@Model.Name</h5>
            <p class="mb-0 text-muted">@(Model.Description ?? "No description")</p>
        </div>

        @if (Model.IceCreams.Any())
        {
            <div class="alert alert-warning">
                This category contains @Model.IceCreams.Count ice cream product(s).
                You must move those products to another category before deleting it.
            </div>
            <a asp-action="Index" class="btn btn-success">Back to Categories</a>
        }
        else
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-light ms-2">Cancel</a>
            </form>
        }
    </div>
</div>
