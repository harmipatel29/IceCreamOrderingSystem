 @model List<IceCreamOrderingSystem.Models.CartItemViewModel>

@{
    ViewData["Title"] = "My Cart";
    var cartItems = Model ?? new List<IceCreamOrderingSystem.Models.CartItemViewModel>();
    decimal total = cartItems.Sum(item => item.Subtotal);
}

<style>
    .cart-page {
        max-width: 1100px;
        margin: 35px auto;
        padding: 0 18px 45px;
    }

    .cart-heading {
        color: #205b3e;
        font-weight: 850;
        margin-bottom: 8px;
        font-size: clamp(28px, 4vw, 36px);
    }

    .cart-subtitle {
        color: #778279;
        margin-bottom: 25px;
    }

    .cart-card {
        background: white;
        border: 1px solid #e5ece7;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px #183b2908;
    }

    .cart-row {
        display: grid;
        grid-template-columns: 90px minmax(150px, 1fr) 125px 120px 85px;
        align-items: center;
        gap: 18px;
        padding: 20px;
        border-bottom: 1px solid #edf0ed;
    }

    .cart-row:last-child {
        border-bottom: none;
    }

    .cart-img {
        width: 85px;
        height: 80px;
        object-fit: cover;
        border-radius: 10px;
        background: #f3f6f3;
    }

    .cart-name {
        font-weight: 750;
        color: #284d37;
        margin-bottom: 5px;
        font-size: 16px;
    }

    .cart-price {
        font-weight: 700;
        color: #205b3e;
    }

    .quantity-input {
        width: 80px;
        border: 1px solid #dce5de;
        padding: 8px;
        border-radius: 8px;
        outline: none;
    }

    .quantity-input:focus {
        border-color: #39835b;
        box-shadow: 0 0 0 3px #39835b18;
    }

    .small-btn {
        border: 0;
        border-radius: 8px;
        padding: 9px 11px;
        font-weight: 650;
        cursor: pointer;
    }

    .update-btn {
        background: #eaf4ec;
        color: #205b3e;
    }

    .update-btn:hover {
        background: #d8ebdc;
    }

    .remove-btn {
        background: #ffeded;
        color: #b32e2e;
    }

    .remove-btn:hover {
        background: #ffdddd;
    }

    .item-total {
        color: #205b3e;
        font-weight: 800;
        white-space: nowrap;
    }

    .summary {
        background: #f5f8f5;
        border: 1px solid #e5ece7;
        padding: 24px;
        border-radius: 14px;
        margin-top: 22px;
    }

    .checkout-btn {
        background: #236746;
        color: white;
        padding: 12px 22px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 700;
        display: inline-block;
        border: 1px solid #236746;
        text-align: center;
    }

    .checkout-btn:hover {
        background: #174d37;
        border-color: #174d37;
        color: white;
    }

    .continue-btn {
        display: inline-block;
        color: #236746;
        font-weight: 700;
        text-decoration: none;
        padding: 12px 16px;
        border: 1px solid #cbdccf;
        border-radius: 9px;
    }

    .continue-btn:hover {
        background: #eaf4ec;
        color: #174d37;
    }

    .empty-cart {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        font-size: 42px;
        color: #39835b;
        margin-bottom: 12px;
    }

    .alert-box {
        padding: 12px 16px;
        border-radius: 9px;
        margin-bottom: 15px;
    }

    .summary-label {
        color: #65746a;
    }

    @@media (max-width: 900px) {
        .cart-row {
            grid-template-columns: 75px minmax(130px, 1fr) 100px;
            gap: 14px;
        }

        .cart-row > form:last-child {
            grid-column: 3;
        }

        .cart-row .item-total {
            grid-column: 2;
        }

        .cart-img {
            width: 70px;
            height: 70px;
        }
    }

    @@media (max-width: 550px) {
        .cart-page {
            margin-top: 24px;
            padding-left: 12px;
            padding-right: 12px;
        }

        .cart-row {
            grid-template-columns: 65px minmax(0, 1fr);
            gap: 12px;
            padding: 15px;
        }

        .cart-row > div,
        .cart-row > form {
            min-width: 0;
        }

        .cart-row > form,
        .cart-row .item-total {
            grid-column: 2;
        }

        .cart-img {
            width: 62px;
            height: 62px;
        }

        .summary {
            padding: 18px;
        }

        .cart-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .cart-actions a {
            width: 100%;
            margin: 0 !important;
        }
    }
</style>

<div class="cart-page">
    <h1 class="cart-heading">My Shopping Cart</h1>
    <p class="cart-subtitle">
        Review your favourite scoops before checkout.
    </p>

    @if (TempData["Success"] != null || TempData["CartSuccess"] != null)
    {
        <div class="alert-box alert alert-success">
            @(TempData["Success"] ?? TempData["CartSuccess"])
        </div>
    }

    @if (TempData["Error"] != null || TempData["CartError"] != null)
    {
        <div class="alert-box alert alert-danger">
            @(TempData["Error"] ?? TempData["CartError"])
        </div>
    }

    @if (cartItems.Any())
    {
        <div class="cart-card">
            @foreach (var item in cartItems)
            {
                <div class="cart-row">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 class="cart-img" />
                        }
                        else
                        {
                            <div class="cart-img d-flex align-items-center justify-content-center text-muted small">
                                No image
                            </div>
                        }
                    </div>

                    <div>
                        <div class="cart-name">@item.Name</div>
                        <div class="text-muted small">
                            ₹@item.Price.ToString("0.00") each
                        </div>
                        <div class="cart-price mt-2">
                            Subtotal: ₹@item.Subtotal.ToString("0.00")
                        </div>
                    </div>

                    <form asp-controller="Cart" asp-action="Update" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@item.IceCreamId" />

                        <label class="small text-muted d-block mb-1">
                            Quantity
                        </label>

                        <input type="number"
                               name="quantity"
                               value="@item.Quantity"
                               min="1"
                               class="quantity-input"
                               required />

                        <button type="submit" class="small-btn update-btn mt-2">
                            Update
                        </button>
                    </form>

                    <div class="item-total">
                        <div class="small text-muted fw-normal mb-1">
                            Item Total
                        </div>
                        ₹@item.Subtotal.ToString("0.00")
                    </div>

                    <form asp-controller="Cart" asp-action="Remove" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@item.IceCreamId" />

                        <button type="submit" class="small-btn remove-btn">
                            Remove
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="summary">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="summary-label">Total items</span>
                <strong>@cartItems.Sum(item => item.Quantity)</strong>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="fw-bold">Grand Total</span>
                <h3 class="fw-bold mb-0" style="color:#205b3e;">
                    ₹@total.ToString("0.00")
                </h3>
            </div>

            <div class="cart-actions d-flex flex-wrap gap-2">
                <a asp-controller="Home"
                   asp-action="Shop"
                   class="continue-btn">
                    Continue Shopping
                </a>

                <a asp-controller="Cart"
                   asp-action="Checkout"
                   class="checkout-btn">
                    Proceed to Checkout
                </a>
                
            </div>

            <p class="small text-muted mt-3 mb-0">
                Your final order total will be calculated using the current product prices at checkout.
            </p>
        </div>
    }
    else
    {
        <div class="cart-card empty-cart">
            <div class="empty-icon">&#128722;</div>

            <h3 class="fw-bold">Your cart is empty</h3>

            <p class="text-muted mt-2">
                Your next favourite scoop is waiting for you.
            </p>

            <a asp-controller="Home"
               asp-action="Shop"
               class="checkout-btn mt-3">
                Explore Ice Creams
            </a>
        </div>
    }
</div>